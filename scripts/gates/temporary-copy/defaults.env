# The temporary copy's defaults, defined once: temporary-copy.sh and dast.sh export each one the environment doesn't
# already set (gate_copy_defaults in scripts/gates/lib.sh), and compose.yaml reads them from there.
# KEY=value lines only, no quotes. Throwaway values that exist only inside the copy: not secrets.

# The copy's Staff account, provisioned by eshop-api at startup.
TEMPORARY_COPY_STAFF_USERNAME=staff
TEMPORARY_COPY_STAFF_PASSWORD=temporary-copy-staff

# The Node image of the readiness check (ready.mjs) and of the ZAP gate's sign-in (dast-session.mjs).
TEMPORARY_COPY_NODE_IMAGE=node:24.22.1-alpine3.24
