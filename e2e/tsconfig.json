{
  // Playwright transpiles the tests itself; tsc only type-checks.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["*.ts", "tests"]
}
