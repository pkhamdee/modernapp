{
  "name": "eshop-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Seam 4: one Playwright browser test of the definition-of-done demo against a deployed environment (post-release smoke test).",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:qa": "E2E_BASE_URL=https://qa.eshop.localhost playwright test",
    "e2e:prod": "E2E_BASE_URL=https://prod.eshop.localhost playwright test",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
