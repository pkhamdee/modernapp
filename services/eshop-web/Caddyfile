# Serves the built single-page app. /api never reaches here: the Gateway routes it to eshop-api.
{
	admin off
	auto_https off
	log {
		output stdout
		format json
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	# Kubernetes probes.
	handle /healthz {
		log_skip
		respond "ok" 200
	}

	# PWA icons (ADR 0006) keep fixed names, so they are cached for a day only. No index.html fallback here:
	# a missing icon is a 404, not the app's HTML cached as an image.
	@icons path /icons/* /apple-touch-icon.png
	handle @icons {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=86400"
		file_server
	}

	# Hashed build assets never change. No index.html fallback: a missing asset (say, a file name from an older
	# deploy) is a 404, not the app's HTML cached for a year as JavaScript.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The service worker, the offline page (#59) and the web app manifest keep fixed names but change with each
	# deploy, so they are always revalidated. No fallback either: a missing one is a 404, never index.html.
	@pwa path /sw.js /offline.html /manifest.webmanifest
	handle @pwa {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv
		encode zstd gzip

		# The page itself (/, /index.html and client-side routes such as /products/...) is always revalidated, so
		# a deploy is picked up on the next visit.
		header Cache-Control "no-cache"

		# Client-side routes (/categories/..., /products/...) fall back to index.html.
		try_files {path} /index.html
		file_server
	}
}
