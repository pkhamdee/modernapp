# Serves the built single-page app. /api never reaches here: the Gateway routes it to eshop-api.
{
	admin off
	auto_https off
	log {
		output stdout
		format json
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	# Every file comes from the build in /srv, compressed when the client accepts it (Caddy compresses text types
	# only, so images are sent as they are).
	root * /srv
	encode zstd gzip

	# Security headers on every response (the ZAP gate, scripts/gates/dast.sh, checks them). The app loads only
	# its own files: no inline scripts or styles (Vite emits none), photos from /images and blob: previews (Staff
	# Handover), API calls to /api, never framed. offline.html has its own, looser policy below.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
	}

	# Kubernetes probes.
	handle /healthz {
		log_skip
		respond "ok" 200
	}

	# PWA icons (ADR 0006) keep fixed names, so they are cached for a day only. No index.html fallback here:
	# a missing icon is a 404, not the app's HTML cached as an image.
	@icons path /icons/* /apple-touch-icon.png
	handle @icons {
		@found file
		header @found Cache-Control "public, max-age=86400"
		file_server
	}

	# Hashed build assets never change. No index.html fallback: a missing asset (say, a file name from an older
	# deploy) is a 404, not the app's HTML cached for a year as JavaScript.
	handle /assets/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The service worker, the offline page (#59) and the web app manifest keep fixed names but change with each
	# deploy, so they are always revalidated. No fallback either: a missing one is a 404, never index.html.
	@pwa path /sw.js /offline.html /manifest.webmanifest
	handle @pwa {
		header Cache-Control "no-cache"
		# The offline page carries its own styles inline, as nothing else may be reachable when it shows, and its
		# retry button's onclick="location.reload()" is allowed by its hash (change both together).
		header /offline.html Content-Security-Policy "default-src 'self'; script-src 'unsafe-hashes' 'sha256-9gOBGqEQINNDuds+tkXbNzih6klbz+KeCyxEj4KRLeM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		file_server
	}

	handle {
		# The page itself (/, /index.html and client-side routes such as /products/...) is always revalidated, so
		# a deploy is picked up on the next visit.
		header Cache-Control "no-cache"

		# Client-side routes (/categories/..., /products/...) fall back to index.html.
		try_files {path} /index.html
		file_server
	}
}
