<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    eshop-sync-master: every 30 s pushes queued Contracts to the Enterprise System (SQL Server) and, from #10,
    pulls back what changed there. Shares the domain/data library with eshop-api; never migrates the database.
    HTTP surface: health checks only.
  -->
  <PropertyGroup>
    <!-- Microsoft.Data.SqlClient refuses Globalization Invariant Mode, so this image needs ICU (chiseled-extra). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Eshop.Data\Eshop.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Eshop.SyncMaster.Tests" />
  </ItemGroup>
</Project>
