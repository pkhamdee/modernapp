<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Seam 2: one eshop-sync-master cycle against a real PostgreSQL and a real SQL Server (Testcontainers).
    SQL Server has no Arm image: CI runs these on an x86 runner (ubuntu-latest); on Apple Silicon Docker runs
    it under Rosetta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Eshop.SyncMaster\Eshop.SyncMaster.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same fake enterprise schema the cluster's SQL Server gets (deploy/thirdparty/mssql). -->
    <None Include="..\..\..\..\deploy\thirdparty\mssql\enterprise-schema.sql" Link="enterprise-schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
