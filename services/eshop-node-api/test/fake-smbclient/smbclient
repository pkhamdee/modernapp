#!/usr/bin/env node
// A stand-in for Samba's `smbclient` used by test/smbImageStore.test.ts. It serves the share from the folder in
// FAKE_SMB_ROOT and answers the commands smbImageStore sends (mkdir, put, get, ls, allinfo) with the same output
// a Samba 4 server without shadow copies gives, including allinfo's trailing
// "NT_STATUS_INVALID_DEVICE_REQUEST getting shadow copy data" line for a file that exists.
// An ES module (the package is "type": "module").
import fs from 'node:fs'
import path from 'node:path'

const root = process.env.FAKE_SMB_ROOT
const args = process.argv.slice(2)
const command = args[args.indexOf('-c') + 1] ?? ''
const [verb, ...rest] = command.match(/"[^"]*"|\S+/g) ?? []
const operands = rest.map((s) => s.replace(/^"|"$/g, ''))
const onShare = (p) => path.join(root, ...p.split('\\').filter(Boolean))

function fail(text) {
  process.stdout.write(`${text}\n`)
  process.exit(1)
}

switch (verb) {
  case 'ls': {
    const target = operands[0] ? onShare(operands[0]) : root
    if (!fs.existsSync(target)) fail(`NT_STATUS_NO_SUCH_FILE listing \\${operands[0]}`)
    const names = fs.statSync(target).isDirectory() ? fs.readdirSync(target) : [path.basename(target)]
    for (const name of names) process.stdout.write(`  ${name}    A    1  Thu Oct 29 13:51:05 2026\n`)
    process.stdout.write('\n\t\t1000 blocks of size 1024. 900 blocks available\n')
    break
  }
  case 'allinfo': {
    const target = onShare(operands[0])
    if (!fs.existsSync(target)) fail(`NT_STATUS_OBJECT_NAME_NOT_FOUND getting alt name for \\${operands[0]}`)
    process.stdout.write(`altname: ${path.basename(target)}\nattributes: A (20)\n`)
    process.stdout.write(`NT_STATUS_INVALID_DEVICE_REQUEST getting shadow copy data for \\${operands[0]}\n`)
    break
  }
  case 'mkdir': {
    const target = onShare(operands[0])
    if (fs.existsSync(target)) fail(`NT_STATUS_OBJECT_NAME_COLLISION making remote directory \\${operands[0]}`)
    fs.mkdirSync(target)
    break
  }
  case 'put':
    fs.copyFileSync(operands[0], onShare(operands[1]))
    process.stdout.write(`putting file ${operands[0]} as \\${operands[1]}\n`)
    break
  case 'get': {
    const target = onShare(operands[0])
    if (!fs.existsSync(target)) fail(`NT_STATUS_OBJECT_NAME_NOT_FOUND opening remote file \\${operands[0]}`)
    fs.copyFileSync(target, operands[1])
    process.stdout.write(`getting file \\${operands[0]} of size 1 as ${operands[1]}\n`)
    break
  }
  default:
    fail(`fake smbclient: unsupported command ${command}`)
}
