{
  "name": "eshop-node-api",
  "private": true,
  "version": "0.0.0",
  "description": "eShop image service: stores images on the SMB share, serves public ones under /images/public",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "IMAGE_STORE=folder IMAGE_FOLDER=.local-share PORT=8081 node --watch src/server.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "oxlint --deny-warnings && tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
